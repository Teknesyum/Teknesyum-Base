{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teknesyum Base",
  "version": "3.0.0",
  "identifier": "com.teknesyum.base",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teknesyum Base",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Teknesyum",
    "copyright": "Copyright (c) 2026 Teknesyum",
    "category": "Utility",
    "shortDescription": "Browse and install the programs of a GitHub account",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
