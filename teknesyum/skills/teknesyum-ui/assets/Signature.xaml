<!-- Teknesyum imza bloğu (WPF). Ayarlar/Hakkında panelinin en altına koy.
     Sponsors onaylanınca NavigateUri'yi https://github.com/sponsors/Teknesyum yap. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
  <TextBlock Text="BY TEKNESYUM" FontSize="10" FontWeight="Bold"
             Foreground="#FF6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
  <Border Background="#1AB026FF" BorderBrush="#4DB026FF" BorderThickness="1"
          CornerRadius="6" Padding="10,4">
    <TextBlock VerticalAlignment="Center">
      <Hyperlink NavigateUri="https://github.com/Teknesyum"
                 TextDecorations="None" Foreground="#FFB026FF"
                 RequestNavigate="OnSignatureNavigate">
        <TextBlock Text="☕ GITHUB" FontSize="10" FontWeight="Bold"/>
      </Hyperlink>
    </TextBlock>
  </Border>
</StackPanel>

