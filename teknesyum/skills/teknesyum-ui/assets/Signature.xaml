<!-- Teknesyum imza bloğu (WPF). Ayarlar/Hakkında panelinin en altına, sağa yaslı. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
  <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
    <Hyperlink NavigateUri="https://github.com/Teknesyum"
               TextDecorations="None" Foreground="#FF6B7280"
               RequestNavigate="OnSignatureNavigate">
      <TextBlock Text="BY TEKNESYUM" FontSize="10" FontWeight="Bold"/>
    </Hyperlink>
  </TextBlock>

  <Border Background="Transparent" BorderBrush="#80B026FF" BorderThickness="1"
          CornerRadius="8" Padding="12,6">
    <Border.Effect>
      <DropShadowEffect Color="#B026FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
    </Border.Effect>
    <StackPanel Orientation="Horizontal">
      <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
        <Path Stroke="#FFB026FF" StrokeThickness="2" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M2 4.5 H8.5 V8 A2 2 0 0 1 6.5 10 H4 A2 2 0 0 1 2 8 Z
                    M8.5 5.5 H9.25 A1.25 1.25 0 0 1 9.25 8 H8.5
                    M4 1.25 V2.25 M6 1.25 V2.25"/>
      </Canvas>
      <TextBlock VerticalAlignment="Center">
        <Hyperlink NavigateUri="https://github.com/sponsors/Teknesyum"
                   TextDecorations="None" Foreground="#FFB026FF"
                   RequestNavigate="OnSignatureNavigate">
          <TextBlock Text="BUY ME A COFFEE" FontSize="10" FontWeight="Bold"/>
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </Border>
</StackPanel>

