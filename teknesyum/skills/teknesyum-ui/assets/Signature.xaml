<!-- Teknesyum imza bloğu (WPF). Yeri başlık şeridi, küçült düğmesinin solu (SKILL.md §4).
     Theme.xaml'ın MergedDictionaries içinde olması gerekir; renkler ve süre oradan gelir. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:loc="clr-namespace:Teknesyum.Localization"
            Orientation="Horizontal" VerticalAlignment="Center"
            WindowChrome.IsHitTestVisibleInChrome="True">

  <StackPanel.Resources>
    <Style x:Key="SigChip" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EOut}"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EIn}"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EIn}"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SigText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </StackPanel.Resources>

  <Border Style="{StaticResource SigChip}" BorderBrush="{StaticResource PinkText}"
          Margin="0,0,8,0" ToolTip="{loc:Str sig.supportTitle}">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <StackPanel Orientation="Horizontal">
      <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
        <Path Stroke="{StaticResource PinkText}" StrokeThickness="2" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M2 4.5 H8.5 V8 A2 2 0 0 1 6.5 10 H4 A2 2 0 0 1 2 8 Z
                    M8.5 5.5 H9.25 A1.25 1.25 0 0 1 9.25 8 H8.5
                    M4 1.25 V2.25 M6 1.25 V2.25"/>
      </Canvas>
      <TextBlock Style="{StaticResource SigText}">
        <Hyperlink NavigateUri="https://github.com/sponsors/Teknesyum"
                   TextDecorations="None" Foreground="{StaticResource PinkText}"
                   RequestNavigate="OnSignatureNavigate">
          <Run Text="{loc:Str sig.support}"/>
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </Border>

  <Border Style="{StaticResource SigChip}" BorderBrush="{StaticResource NeonBlue}"
          ToolTip="{loc:Str sig.brandTitle}">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <TextBlock Style="{StaticResource SigText}">
      <Hyperlink NavigateUri="https://github.com/Teknesyum"
                 TextDecorations="None" Foreground="{StaticResource NeonBlue}"
                 RequestNavigate="OnSignatureNavigate">
        <Run Text="{loc:Str sig.brand}"/>
      </Hyperlink>
    </TextBlock>
  </Border>
</StackPanel>

<!-- code-behind:
private void OnSignatureNavigate(object sender, RequestNavigateEventArgs e)
{
    Process.Start(new ProcessStartInfo(e.Uri.AbsoluteUri) { UseShellExecute = true });
    e.Handled = true;
}

loc:Str = locale/*.json okuyan markup extension (desktop.md §9).
Başlık şeridi yoksa bu blok ayarlar/hakkında panelinin en altına, sağa yaslı konur (§4).
-->
