<!-- Teknesyum Neon - WPF durum katmani: toggle, slider, deger hucresi, ikon buton.
     App.xaml > Application.Resources > MergedDictionaries icine Theme.xaml'DAN SONRA
     eklenir; butun firca, sure ve font kaynaklarini oradan okur, kendi rengi yoktur.
     Gerekceler, olcumler ve muafiyetler: references/durumlar.md.

     NEDEN TAM SABLON: Theme.xaml'da toggle ve slider stili HIC YOK. Web tarafinda durum
     katmani mevcut siniflarin uzerine binerken WPF'te genisletilecek taban yok, o yuzden
     olcu de burada duruyor. Olculer components.md ile birebir ayni: ray 44x24, sap 16,
     hucre 40x40, ikon buton 32x32. Yariçap tektir (6 DIP); daire istisnasi yalnizca
     toggle sapi ve slider sapidir.

     Bes durum her kontrolde tam: duruk, hover, odak, basili, devre disi. Hover hicbir
     yerde tek tasiyici degil, odak esi ayni degeri yaziyor. Basili halin ikinci tasiyicisi
     renktir; WPF'te azaltilmis hareket ayari ScaleTransform'u dusurmez ama parite icin
     kural aynen korundu.

     XAML yorumunda cift tire kullanilamaz; araliklar "ile" ya da tek tire ile yazildi. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ======================================================================
       1 · Toggle (anahtar) - bes durum
       ====================================================================== -->

  <!-- KAPALI halin grisi Disabled fircasidir ve bu, tek gri kuralinin TEK istisnasidir
       (durumlar.md §4). Kapali ile devre disi arasindaki farki RENK YAPMAZ: devre disi
       olan Cursor="No", ToolTip ve AutomationProperties.HelpText tasir, kapali tasimaz.
       Bu yuzden devre disi toggle'a ToolTip vermek zorunludur, secim degildir. -->
  <Style x:Key="TkToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{StaticResource AppBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Disabled}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ray"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="True">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border x:Name="sap" Width="16" Height="16" CornerRadius="8"
                    HorizontalAlignment="Left" Margin="3,0,0,0"
                    Background="{StaticResource Disabled}">
              <Border.RenderTransform>
                <TranslateTransform X="0"/>
              </Border.RenderTransform>
            </Border>
          </Border>
          <ControlTemplate.Triggers>

            <!-- duruk, acik. Sap hareketi gecissiz birakilmaz (SKILL §5.4). -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ray" Property="Background" Value="{StaticResource NeonBlue30}"/>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource NeonBlue60}"/>
              <Setter TargetName="sap" Property="Background" Value="{StaticResource NeonBlue}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sap" To="20"
                                     Duration="{StaticResource TInstant}"
                                     EasingFunction="{StaticResource EOut}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sap" To="0"
                                     Duration="{StaticResource TInstant}"
                                     EasingFunction="{StaticResource EIn}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <!-- hover. Olculdu: BorderStrong yuzey ustunde 5.49:1. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </MultiTrigger>

            <!-- odak. Hover'in esi: ayni cerceve degeri. Halkayi FocusVisualStyle cizer
                 (Theme.xaml, cift katman, gecissiz). Hover tek tasiyici olamaz. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsKeyboardFocused" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </MultiTrigger>

            <!-- basili. Ikinci tasiyici cerceve; olcek tek basina birakilmaz. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ray" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="ray" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ray" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="ray" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>

            <!-- devre disi. En sonda: hover ve basili kurallarini ezer. Olculdu: 4.12:1
                 yuzeyde, 4.35:1 siyah ray uzerinde. Opaklik DEGISMEZ. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ray" Property="Background" Value="Transparent"/>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource Disabled}"/>
              <Setter TargetName="sap" Property="Background" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>

          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================================================================
       2 · Slider - bes durum
       ====================================================================== -->

  <!-- Duruk ray cercevesi BorderDecorative (2.14:1) ve BILEREK 3:1 altindadir: duruk
       tasiyici ray degil, sap ile sagdaki mono degerdir. Hover ve odak rayi 4.11'e cikarir. -->
  <Style x:Key="TkSliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="sap" Width="16" Height="16" CornerRadius="8"
                  Background="{StaticResource NeonBlue}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="sap" Property="Background" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TkSlider" TargetType="Slider">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border x:Name="ray" Height="4" CornerRadius="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppBg}"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderDecorative}"
                    SnapsToDevicePixels="True"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource TkSliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>

            <!-- hover -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
            </MultiTrigger>

            <!-- odak. Hover'in esi, ayni deger; halkayi FocusVisualStyle cizer.
                 Yeni deger yok. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
            </MultiTrigger>

            <!-- basili, yani surukleniyor. WPF'te Slider'in IsPressed'i yok;
                 fare yakalamasi sapin uzerindeyken suruklenme surer. 5.49:1. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseCaptureWithin" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </MultiTrigger>

            <!-- devre disi. En sonda: hover'i ve suruklemeyi ezer, yani hover IPTAL. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ray" Property="BorderBrush" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>

          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================================================================
       3 · Deger hucresi - bes durum
       ====================================================================== -->

  <!-- IKI AYRI SEY, IKI AYRI AD. TkCell secilebilir KONTROLDUR (components.md hucreye
       cursor-pointer ve hover halkasi veriyor); TkValue salt okunur GOSTERIMDIR ve bes
       durumun hicbirini almaz. Ayrim ve gerekcesi durumlar.md §5'te. -->
  <Style x:Key="TkCell" TargetType="ToggleButton">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" CornerRadius="6"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="True">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>

            <!-- duruk, secili -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonBlue20}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonBlue50}"/>
            </Trigger>

            <!-- hover -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonBlue50}"/>
            </MultiTrigger>

            <!-- odak. Hover'in esi. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsKeyboardFocused" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonBlue50}"/>
            </MultiTrigger>

            <!-- basili. Ikinci tasiyici cerceve. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="bd" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="bd" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>

            <!-- devre disi. Hover halkasi ACIKCA iptal: cerceve Disabled'a doner, dolgu
                 seffaflasir, hale kalkar. 4.12:1. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}"/>
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
              <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>

          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Salt okunur gosterim. Bes durumun hicbiri uygulanmaz; Focusable kapali ve
       IsHitTestVisible kapali oldugu icin hover, odak ve basili hal DOGABILIR degil. -->
  <Style x:Key="TkValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- ======================================================================
       4 · Ikon buton - bes durum
       ====================================================================== -->

  <Style x:Key="TkIconButton" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="6"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="True">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>

            <!-- hover: dolgu pembe /10 (1.06), cerceve pembe /50 (2.17) -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonPink10}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonPink50}"/>
              <Setter Property="Foreground" Value="{StaticResource PinkText}"/>
            </MultiTrigger>

            <!-- odak: hover'in esi, ayni uc deger -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsKeyboardFocused" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonPink10}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonPink50}"/>
              <Setter Property="Foreground" Value="{StaticResource PinkText}"/>
            </MultiTrigger>

            <!-- basili: dolgu /10 ile /30 (1.06 ile 1.42), cerceve /50 ile TAM pembe
                 (2.17 ile 6.11). Sicramayi cerceve tasir, olcek degil. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonPink30}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonPink}"/>
              <Setter Property="Foreground" Value="{StaticResource PinkText}"/>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="bd" To="0.98"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                    <DoubleAnimation Storyboard.TargetName="bd" To="1"
                                     Duration="{StaticResource TInstant}"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>

            <!-- devre disi. 4.12:1. ToolTip zorunlu (SKILL §2). -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}"/>
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
              <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>

          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
